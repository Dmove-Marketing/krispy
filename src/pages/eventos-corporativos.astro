---
// Página: Eventos Corporativos — Krispy Buffet
// Estrutura baseada em casamentos.astro / debutantes.astro (mesma identidade visual)
// Depoimentos do Google ainda não recebidos — local reservado com placeholder visual
// (.media-placeholder), pronto para receber o conteúdo real.
import Base from '../layouts/Base.astro';
import config from '../../config.json';
import LeadForm from '../components/forms/LeadForm.astro';
import Video from '../components/ui/Video.astro';
import '../styles/corporativo.css';
---

<style is:global>
  .hero-img { object-position: center 75%; }
  @media(max-width:768px){
    .hero-img { object-position: center 80%; }
  }
</style>

<Base
  title="Krispy - Eventos Corporativos"
  ogImage="/images/og-corporativo.jpg"
  whatsappTipoOptions={['Corporativo', 'Confraternização corporativa', 'Offsite corporativo', 'Outros']}
  whatsappShowBudget={true}
>
<div style="font-family: Parkinsans, sans-serif; color: #f6f2ec; background: #2f1d13;">

  <!-- ── NAV ───────────────────────────────────────────────────────── -->
  <nav class="r-nav" style="position: fixed; top: 0px; left: 0px; right: 0px; z-index: 100; display: flex; justify-content: space-between; align-items: center; padding: 24px 60px; background: transparent; border-bottom: 1px solid rgba(162, 125, 40, 0.25); transition: padding 0.4s, background 0.3s; box-shadow: none;">
    <a href="#topo" style="text-decoration: none; margin-right: 48px; display: flex; align-items: center;">
      <img src="https://media.dmove.com.br/clients/krispy/photos/logo_krispy.webp" alt="Krispy Buffet" style="height: 48px; width: auto;" />
    </a>
    <div class="r-nav-links" style="display: flex; align-items: center; gap: 40px;">
      <a href="#sobre" class="scp0" style="font-size: 11px; letter-spacing: 2.5px; text-transform: uppercase; color: rgba(255, 255, 255, 0.7); text-decoration: none; font-weight: 500;">Sobre</a>
      <a href="#estrutura" class="scp0" style="font-size: 11px; letter-spacing: 2.5px; text-transform: uppercase; color: rgba(255, 255, 255, 0.7); text-decoration: none; font-weight: 500;">Estrutura</a>
      <a href="#gastronomia" class="scp0" style="font-size: 11px; letter-spacing: 2.5px; text-transform: uppercase; color: rgba(255, 255, 255, 0.7); text-decoration: none; font-weight: 500;">Gastronomia</a>
      <a href="#galeria" class="scp0" style="font-size: 11px; letter-spacing: 2.5px; text-transform: uppercase; color: rgba(255, 255, 255, 0.7); text-decoration: none; font-weight: 500;">Galeria</a>
      <a href="#contato" class="scp0" style="font-size: 11px; letter-spacing: 2.5px; text-transform: uppercase; color: rgba(255, 255, 255, 0.7); text-decoration: none; font-weight: 500;">Contato</a>
      <a href="#contato" class="scp1" style="background: #A27D28; border: 1px solid #A27D28; color: rgb(255, 255, 255); padding: 11px 24px; font-size: 10px; letter-spacing: 2.5px; text-transform: uppercase; cursor: pointer; text-decoration: none; font-weight: 600; transition: background 0.3s; border-radius: 6px;">Solicite orçamento</a>
    </div>
    <button aria-label="Abrir menu" class="r-burger" style="display: none; flex-direction: column; gap: 5px; cursor: pointer; background: none; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; padding: 4px;">
      <span style="display: block; width: 24px; height: 1.5px; background: #f6f2ec;"></span>
      <span style="display: block; width: 24px; height: 1.5px; background: #f6f2ec;"></span>
      <span style="display: block; width: 24px; height: 1.5px; background: #f6f2ec;"></span>
    </button>
  </nav>

  <!-- ── MENU MOBILE ───────────────────────────────────────────────── -->
  <div class="r-mobile-menu" style="display: none; position: fixed; inset: 0px; z-index: 105; background: rgba(47, 29, 19, 0.98); backdrop-filter: blur(16px); flex-direction: column; align-items: center; justify-content: center; gap: 30px;">
    <a href="#sobre" style="font-family: Georgia, serif; font-size: 30px; font-weight: 400; color: #f6f2ec; text-decoration: none; letter-spacing: 3px;">Sobre</a>
    <a href="#estrutura" style="font-family: Georgia, serif; font-size: 30px; font-weight: 400; color: #f6f2ec; text-decoration: none; letter-spacing: 3px;">Estrutura</a>
    <a href="#gastronomia" style="font-family: Georgia, serif; font-size: 30px; font-weight: 400; color: #f6f2ec; text-decoration: none; letter-spacing: 3px;">Gastronomia</a>
    <a href="#galeria" style="font-family: Georgia, serif; font-size: 30px; font-weight: 400; color: #f6f2ec; text-decoration: none; letter-spacing: 3px;">Galeria</a>
    <a href="#contato" style="font-family: Georgia, serif; font-size: 30px; font-weight: 400; color: #f6f2ec; text-decoration: none; letter-spacing: 3px;">Contato</a>
    <a href="#contato" style="margin-top: 12px; background: #A27D28; color: rgb(255, 255, 255); padding: 14px 36px; font-size: 10px; letter-spacing: 2.5px; text-transform: uppercase; font-weight: 600; text-decoration: none; border-radius: 6px;">Solicite orçamento</a>
  </div>

  <!-- ── HERO ──────────────────────────────────────────────────────── -->
  <section id="topo" style="height: 100vh; min-height: 620px; position: relative; display: flex; align-items: flex-end; overflow: hidden; background: #2f1d13;">
    <img src="https://media.dmove.com.br/clients/krispy/photos/hero_corporativo_resultado.webp" alt="Evento corporativo Krispy Buffet" fetchpriority="high" class="hero-img" style="position: absolute; inset: 0px; width: 100%; height: 100%; object-fit: cover; transform: scale(1.04); animation: 12s ease-out 0s 1 normal forwards running heroZoom;" />
    <div style="position: absolute; inset: 0px; background: linear-gradient(to top, rgba(21, 13, 7, 0.92) 0%, rgba(21, 13, 7, 0.45) 55%, rgba(21, 13, 7, 0.2) 100%);"></div>
    <div class="r-hero" style="position: relative; z-index: 2; padding: 0px 60px 88px; max-width: 880px;">
      <h1 style="font-family: Georgia, serif; font-size: clamp(34px, min(5.4vw, 6vh), 68px); font-weight: 400; color: #f6f2ec; line-height: 1.12; margin-bottom: 30px; letter-spacing: -0.3px;">Praticidade, estrutura e<br /><span style="font-weight: 500; color: #f6f2ec;">elegância para seu<br />evento corporativo</span></h1>
      <p style="font-size: 16px; color: rgba(255, 255, 255, 0.72); line-height: 1.85; max-width: 520px; margin-bottom: 22px; font-weight: 300;">Reúna sua equipe em um espaço completo, com gastronomia própria e atendimento dedicado para tornar cada encontro um sucesso.</p>
      <span style="font-size: 11px; letter-spacing: 5px; text-transform: uppercase; color: #ffffff; margin-bottom: 44px; display: block; font-weight: 500;">Corporativo • até 150 convidados • Campo Grande</span>
      <div style="display: flex; gap: 22px; align-items: center; flex-wrap: wrap;">
        <a href="#contato" class="scp2" style="background: #A27D28; color: rgb(255, 255, 255); padding: 17px 38px; font-size: 10px; letter-spacing: 3px; text-transform: uppercase; font-weight: 600; text-decoration: none; transition: background 0.3s, transform 0.3s; border-radius: 6px;">Solicite orçamento</a>
      </div>
    </div>
  </section>

  <!-- ── AUTORIDADE ────────────────────────────────────────────────── -->
  <div class="r-autoridade" style="background: linear-gradient(135deg, #A27D28 0%, #A27D28 45%, #A27D28 100%); display: flex; justify-content: center; flex-wrap: nowrap; box-shadow: rgba(162, 125, 40, 0.25) 0px 2px 14px;">
    <div class="r-stat" style="padding: 28px 56px; text-align: center; border-right: 1px solid rgba(255, 255, 255, 0.28); flex: 0 0 auto; white-space: nowrap;">
      <span style="font-size: 16px; letter-spacing: 3px; text-transform: uppercase; color: rgb(255, 255, 255); display: block; font-weight: 600;">Avaliação 4,8 no Google</span>
    </div>
    <div class="r-stat" style="padding: 28px 56px; text-align: center; flex: 0 0 auto; white-space: nowrap;">
      <span style="font-size: 16px; letter-spacing: 3px; text-transform: uppercase; color: rgb(255, 255, 255); display: block; font-weight: 600;">Espaço + Buffet</span>
    </div>
  </div>

  <!-- ── SOBRE ─────────────────────────────────────────────────────── -->
  <section id="sobre" class="r-grid2 sobre-corp" style="display: grid; grid-template-columns: 1fr 1fr; min-height: 600px; scroll-margin-top: 80px;">
    <div class="r-media sobre-corp__video" style="min-height: 520px; position: relative; overflow: hidden;">
      <Video
        src="https://media.dmove.com.br/clients/krispy/videos/video_corporativo.webm"
        poster="/images/video-poster-casamentos.jpg"
        title="Krispy Buffet — Eventos Corporativos"
        description="Conheça o Krispy Buffet, espaço para eventos corporativos em Campo Grande."
        uploadDate="2025-01-01"
        duration="PT1M"
        class="sobre-corp__player"
      />
    </div>
    <div data-reveal="" class="r-pad-inner" style="background: #faf5ef; border-left: 4px solid #A27D28; padding: 84px 72px; display: flex; flex-direction: column; justify-content: center; opacity: 1; transform: none; transition: opacity 0.8s, transform 0.8s;">
      <span style="font-size: 10px; letter-spacing: 5px; text-transform: uppercase; color: #A27D28; margin-bottom: 22px; display: block; font-weight: 600;">Sobre o Krispy</span>
      <h2 style="font-family: Georgia, serif; font-size: clamp(28px, 2.6vw, 42px); font-weight: 400; color: #2f1d13; line-height: 1.22; margin-bottom: 28px; letter-spacing: -0.2px;">Excelência em cada etapa<br /><span style="font-weight: 500; color: #A27D28;">do seu evento corporativo</span></h2>
      <p style="font-size: 16px; line-height: 1.9; color: rgba(47, 29, 19, 0.7); font-weight: 300; margin-bottom: 24px;">O Krispy reúne espaço e buffet em um único lugar para simplificar a organização dos seus eventos corporativos, com atendimento dedicado do primeiro contato ao encerramento.</p>
      <p style="font-size: 16px; line-height: 1.9; color: rgba(47, 29, 19, 0.7); font-weight: 300;">Seja para uma confraternização de equipe, um treinamento, um lançamento ou uma reunião especial, oferecemos estrutura completa, gastronomia de qualidade e um atendimento próximo para que sua empresa se preocupe apenas em aproveitar o momento.</p>
    </div>
  </section>





  <!-- ── DIFERENCIAIS ──────────────────────────────────────────────── -->
  <section class="r-sec" style="background: #ffffff; padding: 104px 60px;">
    <div data-reveal style="max-width: 820px; margin: 0px auto 60px; text-align: center;">
      <span style="font-size: 10px; letter-spacing: 5px; text-transform: uppercase; color: #A27D28; margin-bottom: 20px; display: block; font-weight: 600;">Diferenciais</span>
      <h2 style="font-family: Georgia, serif; font-size: clamp(28px, 2.8vw, 44px); font-weight: 400; color: #2f1d13; line-height: 1.2; letter-spacing: -0.2px;">Por que as empresas<br /><span style="font-weight: 500; color: #A27D28;">escolhem o Krispy?</span></h2>
    </div>
    <div class="r-grid3" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; max-width: 1100px; margin: 0px auto;">
      <div data-reveal class="corp-card" style="background: #ffffff; border: 1px solid rgba(162, 125, 40, 0.2); overflow: hidden;">
        <div style="aspect-ratio: 4 / 3; overflow: hidden;">
          <img src="https://media.dmove.com.br/clients/krispy/photos/espaco-buffet_corporativo_resultado.webp" alt="Espaço e buffet integrados — Krispy Buffet" loading="eager" style="width: 100%; height: 100%; object-fit: cover; display: block;" />
        </div>
        <div style="padding: 34px 30px 38px;">
          <h3 style="font-family: Georgia, serif; font-size: 16px; font-weight: 500; color: #2f1d13; margin-bottom: 12px; line-height: 1.25;">Espaço e buffet integrados</h3>
          <p style="font-size: 14px; line-height: 1.75; color: rgba(47, 29, 19, 0.7); font-weight: 300;">Mais praticidade na organização, com um único fornecedor para cuidar dos principais serviços do evento.</p>
        </div>
      </div>
      <div data-reveal class="corp-card" style="background: #ffffff; border: 1px solid rgba(162, 125, 40, 0.2); overflow: hidden;">
        <div style="aspect-ratio: 4 / 3; overflow: hidden;">
          <img src="https://media.dmove.com.br/clients/krispy/photos/gastronomia-propria_corporativo_resultado.webp" alt="Gastronomia própria — Krispy Buffet" loading="eager" style="width: 100%; height: 100%; object-fit: cover; display: block;" />
        </div>
        <div style="padding: 34px 30px 38px;">
          <h3 style="font-family: Georgia, serif; font-size: 16px; font-weight: 500; color: #2f1d13; margin-bottom: 12px; line-height: 1.25;">Gastronomia própria</h3>
          <p style="font-size: 14px; line-height: 1.75; color: rgba(47, 29, 19, 0.7); font-weight: 300;">Cardápios variados preparados por uma equipe especializada para diferentes formatos de eventos.</p>
        </div>
      </div>
      <div data-reveal class="corp-card" style="background: #ffffff; border: 1px solid rgba(162, 125, 40, 0.2); overflow: hidden;">
        <div style="aspect-ratio: 4 / 3; overflow: hidden;">
          <img src="https://media.dmove.com.br/clients/krispy/photos/custo-beneficio_corporativo_resultado.webp" alt="Excelente custo-benefício — Krispy Buffet" loading="eager" style="width: 100%; height: 100%; object-fit: cover; display: block;" />
        </div>
        <div style="padding: 34px 30px 38px;">
          <h3 style="font-family: Georgia, serif; font-size: 16px; font-weight: 500; color: #2f1d13; margin-bottom: 12px; line-height: 1.25;">Excelente custo-benefício</h3>
          <p style="font-size: 14px; line-height: 1.75; color: rgba(47, 29, 19, 0.7); font-weight: 300;">Estrutura completa, atendimento personalizado e investimento inteligente para sua empresa.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── EXPERIÊNCIA ───────────────────────────────────────────────── -->
  <section class="r-sec" style="background: #2f1d13; padding: 108px 60px;">
    <div data-reveal style="max-width: 760px; margin: 0px auto 56px; text-align: center;">
      <span style="font-size: 10px; letter-spacing: 5px; text-transform: uppercase; color: #A27D28; margin-bottom: 20px; display: block; font-weight: 600;">Experiência Krispy</span>
      <h2 style="font-family: Georgia, serif; font-size: clamp(28px, 2.8vw, 44px); font-weight: 400; color: #f6f2ec; line-height: 1.2; margin-bottom: 26px; letter-spacing: -0.2px;">Enquanto sua equipe <br class="br-m" />aproveita o evento,<br /><span style="font-weight: 500; color: #A27D28;">nós cuidamos de toda <br class="br-m" />a operação</span></h2>
      <p style="font-size: 16px; line-height: 1.9; color: rgba(255, 255, 255, 0.6); font-weight: 300;">Da organização ao atendimento durante o evento, nossa equipe acompanha cada etapa para garantir uma experiência agradável, organizada e sem preocupações.</p>
    </div>
    <div id="exp-carousel" style="max-width: 1100px; margin: 0 auto 48px; overflow: hidden;">
      <div id="exp-track" style="display: flex; gap: 3px;">
        <div class="exp-slide" style="aspect-ratio: 3 / 4; overflow: hidden; flex-shrink: 0;">
          <img src="https://media.dmove.com.br/clients/krispy/photos/carrossel-experiencia_corporativo05_resultadov2.webp" alt="Evento corporativo Krispy" loading="eager" style="width: 100%; height: 100%; object-fit: cover; display: block;" />
        </div>
        <div class="exp-slide" style="aspect-ratio: 3 / 4; overflow: hidden; flex-shrink: 0;">
          <img src="https://media.dmove.com.br/clients/krispy/photos/carrossel-experiencia_corporativo04_resultadovz.webp" alt="Evento corporativo Krispy" loading="eager" style="width: 100%; height: 100%; object-fit: cover; display: block;" />
        </div>
        <div class="exp-slide" style="aspect-ratio: 3 / 4; overflow: hidden; flex-shrink: 0;">
          <img src="https://media.dmove.com.br/clients/krispy/photos/carrossel-experiencia_corporativo03_resultado.webp" alt="Evento corporativo Krispy" loading="eager" style="width: 100%; height: 100%; object-fit: cover; display: block;" />
        </div>
        <div class="exp-slide" style="aspect-ratio: 3 / 4; overflow: hidden; flex-shrink: 0;">
          <img src="https://media.dmove.com.br/clients/krispy/photos/carrossel-experiencia_corporativo02_resultado.webp" alt="Evento corporativo Krispy" loading="eager" style="width: 100%; height: 100%; object-fit: cover; display: block;" />
        </div>
        <div class="exp-slide" style="aspect-ratio: 3 / 4; overflow: hidden; flex-shrink: 0;">
          <img src="https://media.dmove.com.br/clients/krispy/photos/carrossel-experiencia_corporativo01_resultado.webp" alt="Evento corporativo Krispy" loading="eager" style="width: 100%; height: 100%; object-fit: cover; display: block;" />
        </div>
      </div>
    </div>
  </section>

  <!-- ── ESTRUTURA ─────────────────────────────────────────────────── -->
  <section id="estrutura" class="r-sec" style="background: #ffffff; padding: 104px 60px; scroll-margin-top: 80px;">
    <div data-reveal style="max-width: 840px; margin: 0px auto 60px; text-align: center;">
      <span style="font-size: 10px; letter-spacing: 5px; text-transform: uppercase; color: #A27D28; margin-bottom: 20px; display: block; font-weight: 600;">Estrutura</span>
      <h2 style="font-family: Georgia, serif; font-size: clamp(28px, 2.8vw, 44px); font-weight: 400; color: #2f1d13; line-height: 1.2; margin-bottom: 24px; letter-spacing: -0.2px;">Estrutura completa para eventos corporativos<br /><span style="font-weight: 500; color: #A27D28;">de diferentes formatos</span></h2>
      <p style="font-size: 16px; line-height: 1.85; color: rgba(47, 29, 19, 0.7); font-weight: 300; max-width: 600px; margin: 0px auto;">Um ambiente preparado para receber empresas com conforto, praticidade e toda a infraestrutura necessária para um evento bem executado.</p>
    </div>
    <div class="r-grid4" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 2px; max-width: 1140px; margin: 0px auto;">
      <div data-reveal class="icon-card" style="background: #ffffff; border: 1px solid rgba(162, 125, 40, 0.18); padding: 42px 30px; text-align: center;">
        <div class="icon-circle" style="width: 56px; height: 56px; border: 1px solid rgba(162, 125, 40, 0.4); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0px auto 22px;"><svg viewBox="0 0 24 24" fill="none" stroke="#A27D28" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="width: 24px; height: 24px;"><rect x="3" y="4" width="18" height="14" rx="1"></rect><path d="M3 18h18M8 21h8"></path></svg></div>
        <span style="font-size: 13px; font-weight: 500; color: #2f1d13; letter-spacing: 0.3px; line-height: 1.5; display: block;">Salão interno moderno<br />e climatizado</span>
      </div>
      <div data-reveal class="icon-card" style="background: #ffffff; border: 1px solid rgba(162, 125, 40, 0.18); padding: 42px 30px; text-align: center;">
        <div class="icon-circle" style="width: 56px; height: 56px; border: 1px solid rgba(162, 125, 40, 0.4); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0px auto 22px;"><svg viewBox="0 0 24 24" fill="none" stroke="#A27D28" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="width: 24px; height: 24px;"><path d="M12 2l2.4 5.5L20 8l-4 4 1 6-5-3-5 3 1-6-4-4 5.6-.5z"></path></svg></div>
        <span style="font-size: 13px; font-weight: 500; color: #2f1d13; letter-spacing: 0.3px; line-height: 1.5; display: block;">Ambiente sofisticado<br />e versátil</span>
      </div>
      <div data-reveal class="icon-card" style="background: #ffffff; border: 1px solid rgba(162, 125, 40, 0.18); padding: 42px 30px; text-align: center;">
        <div class="icon-circle" style="width: 56px; height: 56px; border: 1px solid rgba(162, 125, 40, 0.4); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0px auto 22px;"><svg viewBox="0 0 24 24" fill="none" stroke="#A27D28" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="width: 24px; height: 24px;"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"></path></svg></div>
        <span style="font-size: 13px; font-weight: 500; color: #2f1d13; letter-spacing: 0.3px; line-height: 1.5; display: block;">Capacidade para até<br />150 convidados</span>
      </div>
      <div data-reveal class="icon-card" style="background: #ffffff; border: 1px solid rgba(162, 125, 40, 0.18); padding: 42px 30px; text-align: center;">
        <div class="icon-circle" style="width: 56px; height: 56px; border: 1px solid rgba(162, 125, 40, 0.4); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0px auto 22px;"><svg viewBox="0 0 24 24" fill="none" stroke="#A27D28" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="width: 24px; height: 24px;"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg></div>
        <span style="font-size: 13px; font-weight: 500; color: #2f1d13; letter-spacing: 0.3px; line-height: 1.5; display: block;">Fácil acesso e<br />localização privilegiada</span>
      </div>
      <div data-reveal class="icon-card" style="background: #ffffff; border: 1px solid rgba(162, 125, 40, 0.18); padding: 42px 30px; text-align: center;">
        <div class="icon-circle" style="width: 56px; height: 56px; border: 1px solid rgba(162, 125, 40, 0.4); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0px auto 22px;"><svg viewBox="0 0 24 24" fill="none" stroke="#A27D28" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="width: 24px; height: 24px;"><path d="M3 11h18M5 11a7 7 0 0 1 14 0M12 3v2M4 21h16"></path></svg></div>
        <span style="font-size: 13px; font-weight: 500; color: #2f1d13; letter-spacing: 0.3px; line-height: 1.5; display: block;">Buffet<br />próprio</span>
      </div>
