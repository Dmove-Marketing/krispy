---
// Gerado a partir de: casamentos.html
import Base from '../layouts/Base.astro';
import config from '../../config.json';
import LeadForm from '../components/forms/LeadForm.astro';
import Video from '../components/ui/Video.astro';
import '../styles/casamentos.css';
---

<Base
  title="Krispy - Casamentos"
  ogImage="/images/og-casamentos.jpg"
>
<div id="dc-root"><div class="sc-host" data-sc-name="Casamento Krispy - Offline (1)"><div data-dc-tpl="5" style="font-family: Parkinsans, sans-serif; color: #f6f2ec; background: #2f1d13;">

  
  <nav data-dc-tpl="6" class="r-nav" style="position: fixed; top: 0px; left: 0px; right: 0px; z-index: 100; display: flex; justify-content: space-between; align-items: center; padding: 24px 60px; background: rgba(47, 29, 19, 0.78); backdrop-filter: blur(12px); border-bottom: 1px solid rgba(162, 125, 40, 0.25); transition: padding 0.4s, background 0.3s; box-shadow: none;">
    <a data-dc-tpl="7" href="#topo" style="text-decoration: none; margin-right: 48px; display: flex; align-items: center;">
      <img src="https://media.dmove.com.br/clients/krispy/photos/logo_krispy.webp" alt="Krispy Buffet" style="height: 48px; width: auto;" />
    </a>
    <div data-dc-tpl="8" class="r-nav-links" style="display: flex; align-items: center; gap: 40px;">
      <a data-dc-tpl="9" href="#sobre" class="scp0" style="font-size: 11px; letter-spacing: 2.5px; text-transform: uppercase; color: rgba(255, 255, 255, 0.7); text-decoration: none; font-weight: 500;">Sobre</a>
      <a data-dc-tpl="10" href="#estrutura" class="scp0" style="font-size: 11px; letter-spacing: 2.5px; text-transform: uppercase; color: rgba(255, 255, 255, 0.7); text-decoration: none; font-weight: 500;">Estrutura</a>
      <a data-dc-tpl="11" href="#gastronomia" class="scp0" style="font-size: 11px; letter-spacing: 2.5px; text-transform: uppercase; color: rgba(255, 255, 255, 0.7); text-decoration: none; font-weight: 500;">Gastronomia</a>
      <a data-dc-tpl="12" href="#galeria" class="scp0" style="font-size: 11px; letter-spacing: 2.5px; text-transform: uppercase; color: rgba(255, 255, 255, 0.7); text-decoration: none; font-weight: 500;">Galeria</a>
      <a data-dc-tpl="13" href="#contato" class="scp0" style="font-size: 11px; letter-spacing: 2.5px; text-transform: uppercase; color: rgba(255, 255, 255, 0.7); text-decoration: none; font-weight: 500;">Contato</a>
      <a data-dc-tpl="14" href="#contato" class="scp1" style="background: #A27D28; border: 1px solid #A27D28; color: rgb(255, 255, 255); padding: 11px 24px; font-size: 10px; letter-spacing: 2.5px; text-transform: uppercase; cursor: pointer; text-decoration: none; font-weight: 600; transition: background 0.3s; border-radius: 6px;">Solicite orçamento</a>
    </div>
    <button data-dc-tpl="15" aria-label="Abrir menu" class="r-burger" style="display: none; flex-direction: column; gap: 5px; cursor: pointer; background: none; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; padding: 4px;">
      <span data-dc-tpl="16" style="display: block; width: 24px; height: 1.5px; background: #f6f2ec;"></span>
      <span data-dc-tpl="17" style="display: block; width: 24px; height: 1.5px; background: #f6f2ec;"></span>
      <span data-dc-tpl="18" style="display: block; width: 24px; height: 1.5px; background: #f6f2ec;"></span>
    </button>
  </nav>

  
  <div data-dc-tpl="19" style="display: none; position: fixed; inset: 0px; z-index: 105; background: rgba(47, 29, 19, 0.98); backdrop-filter: blur(16px); flex-direction: column; align-items: center; justify-content: center; gap: 30px;">
    <a data-dc-tpl="20" href="#sobre" style="font-family: Georgia, serif; font-size: 30px; font-weight: 400; color: #f6f2ec; text-decoration: none; letter-spacing: 3px;">Sobre</a>
    <a data-dc-tpl="21" href="#estrutura" style="font-family: Georgia, serif; font-size: 30px; font-weight: 400; color: #f6f2ec; text-decoration: none; letter-spacing: 3px;">Estrutura</a>
    <a data-dc-tpl="22" href="#gastronomia" style="font-family: Georgia, serif; font-size: 30px; font-weight: 400; color: #f6f2ec; text-decoration: none; letter-spacing: 3px;">Gastronomia</a>
    <a data-dc-tpl="23" href="#galeria" style="font-family: Georgia, serif; font-size: 30px; font-weight: 400; color: #f6f2ec; text-decoration: none; letter-spacing: 3px;">Galeria</a>
    <a data-dc-tpl="24" href="#contato" style="font-family: Georgia, serif; font-size: 30px; font-weight: 400; color: #f6f2ec; text-decoration: none; letter-spacing: 3px;">Contato</a>
    <a data-dc-tpl="25" href="#contato" style="margin-top: 12px; background: #A27D28; color: rgb(255, 255, 255); padding: 14px 36px; font-size: 10px; letter-spacing: 2.5px; text-transform: uppercase; font-weight: 600; text-decoration: none; border-radius: 6px;">Solicite orçamento</a>
  </div>

  
  <section data-dc-tpl="26" id="topo" style="height: 100vh; min-height: 620px; position: relative; display: flex; align-items: flex-end; overflow: hidden; background: #2f1d13;">
    <img src="https://media.dmove.com.br/clients/krispy/photos/ACABAAAAAAAAAAAAAAAAAAAAAAAAAAAA.jpg.webp" alt="Casamento Krispy Buffet" fetchpriority="high" style="position: absolute; inset: 0px; width: 100%; height: 100%; object-fit: cover; object-position: 90% 12%; transform: scale(1.04); animation: 12s ease-out 0s 1 normal forwards running heroZoom;" />
    <div data-dc-tpl="28" style="position: absolute; inset: 0px; background: linear-gradient(to top, rgba(21, 13, 7, 0.92) 0%, rgba(21, 13, 7, 0.45) 55%, rgba(21, 13, 7, 0.2) 100%);"></div>
    <div data-dc-tpl="30" class="r-hero" style="position: relative; z-index: 2; padding: 0px 60px 88px; max-width: 880px;">
      <span data-dc-tpl="31" style="font-size: 11px; letter-spacing: 5px; text-transform: uppercase; color: #ffffff; margin-bottom: 22px; display: block; font-weight: 500;">Mini Wedding · Casamento · Campo Grande</span>
      <h1 data-dc-tpl="32" style="font-family: Georgia, serif; font-size: clamp(34px, min(5.4vw, 6vh), 68px); font-weight: 400; color: #f6f2ec; line-height: 1.12; margin-bottom: 30px; letter-spacing: -0.3px;">Seu grande dia merece<br data-dc-tpl="33" />mais que uma festa.<br /><span data-dc-tpl="34" style="font-weight: 500; color: #f6f2ec;">Merece uma experiência<br />inesquecível!</span></h1>
      <p data-dc-tpl="35" style="font-size: 16px; color: rgba(255, 255, 255, 0.72); line-height: 1.85; max-width: 520px; margin-bottom: 44px; font-weight: 300;">Mais de duas décadas transformando o casamento dos seus sonhos em uma celebração cuidadosamente planejada, espaço e buffet integrados, em Campo Grande.</p>
      <div data-dc-tpl="36" style="display: flex; gap: 22px; align-items: center; flex-wrap: wrap;">
        <a data-dc-tpl="37" href="#contato" class="scp2" style="background: #A27D28; color: rgb(255, 255, 255); padding: 17px 38px; font-size: 10px; letter-spacing: 3px; text-transform: uppercase; font-weight: 600; text-decoration: none; transition: background 0.3s, transform 0.3s; border-radius: 6px;">Solicite orçamento</a>
      </div>
    </div>
  </section>

  
  
  <div data-dc-tpl="40" style="background: linear-gradient(135deg, #A27D28 0%, #A27D28 45%, #A27D28 100%); display: flex; justify-content: center; flex-wrap: wrap; box-shadow: rgba(162, 125, 40, 0.25) 0px 2px 14px;">
    <div data-dc-tpl="41" class="r-stat" style="padding: 38px 56px; text-align: center; border-right: 1px solid rgba(255, 255, 255, 0.28); flex: 1 1 0%; max-width: 300px;">
      <span data-dc-tpl="42" style="font-family: Georgia, serif; font-size: 40px; font-weight: 400; color: rgb(255, 255, 255); display: block; line-height: 1; letter-spacing: -0.5px;">+20</span>
      <span data-dc-tpl="43" style="font-size: 10px; letter-spacing: 3px; text-transform: uppercase; color: rgba(255, 255, 255, 0.85); margin-top: 10px; display: block; font-weight: 500;">anos de experiência</span>
    </div>
    <div data-dc-tpl="44" class="r-stat" style="padding: 38px 56px; text-align: center; border-right: 1px solid rgba(255, 255, 255, 0.28); flex: 1 1 0%; max-width: 300px;">
      <span data-dc-tpl="45" style="font-family: Georgia, serif; font-size: 40px; font-weight: 400; color: rgb(255, 255, 255); display: block; line-height: 1; letter-spacing: -0.5px;">150</span>
      <span data-dc-tpl="46" style="font-size: 10px; letter-spacing: 3px; text-transform: uppercase; color: rgba(255, 255, 255, 0.85); margin-top: 10px; display: block; font-weight: 500;">convidados</span>
    </div>
    <div data-dc-tpl="47" class="r-stat" style="padding: 38px 56px; text-align: center; flex: 1 1 0%; max-width: 300px;">
      <span data-dc-tpl="48" style="font-family: Georgia, serif; font-size: 40px; font-weight: 400; color: rgb(255, 255, 255); display: block; line-height: 1; letter-spacing: -0.5px;">Espaço + Buffet</span>
      <span data-dc-tpl="49" style="font-size: 10px; letter-spacing: 3px; text-transform: uppercase; color: rgba(255, 255, 255, 0.85); margin-top: 10px; display: block; font-weight: 500;">em um só lugar</span>
    </div>
  </div>
  

  
  <section data-dc-tpl="50" id="sobre" class="r-grid2" style="display: grid; grid-template-columns: 1fr 1fr; min-height: 600px; scroll-margin-top: 80px;">
    <div class="r-media" style="background: #2f1d13; min-height: 520px; position: relative; overflow: hidden;">
      <Video
        src="https://media.dmove.com.br/clients/krispy/videos/SaveClip.App_AQPxY-zUjWwg_NMuS3fR8MRelPlRbSiiiVCmIuS5kYKB7Uby0E4UUEZX9_xSu35pd0ZXIxKDPhM-we5qtpN_s0ZP2TMdEao69aU8KeY_(1).mp4"
        poster="/images/video-poster-casamentos.jpg"
        title="Krispy Buffet — Vídeo Institucional"
        description="Conheça o Krispy Buffet, espaço para casamentos e mini weddings em Campo Grande."
        uploadDate="2025-01-01"
        duration="PT1M"
        class="video-panel-fill"
      />
    </div>
    <div data-dc-tpl="55" data-reveal="" class="r-pad-inner" style="background: #faf5ef; border-left: 4px solid #A27D28; padding: 84px 72px; display: flex; flex-direction: column; justify-content: center; opacity: 1; transform: none; transition: opacity 0.8s, transform 0.8s;">
      <span data-dc-tpl="56" style="font-size: 10px; letter-spacing: 5px; text-transform: uppercase; color: #A27D28; margin-bottom: 22px; display: block; font-weight: 600;">Sobre o Krispy</span>
      <h2 data-dc-tpl="57" style="font-family: Georgia, serif; font-size: clamp(28px, 2.6vw, 42px); font-weight: 400; color: #2f1d13; line-height: 1.22; margin-bottom: 28px; letter-spacing: -0.2px;">A experiência de quem entende<br /><span data-dc-tpl="58" style="font-weight: 500; color: #A27D28;">a importância desse momento</span></h2>
      <p data-dc-tpl="59" style="font-size: 16px; line-height: 1.9; color: rgba(47, 29, 19, 0.7); font-weight: 300; margin-bottom: 24px;">Mais do que realizar eventos, o Krispy nasceu para que os noivos possam viver essa fase com mais leveza e segurança.</p>
      <p data-dc-tpl="60" style="font-size: 16px; line-height: 1.9; color: rgba(47, 29, 19, 0.7); font-weight: 300;">São mais de <b data-dc-tpl="61" style="font-weight: 600; color: #2f1d13;">20 anos de atuação</b> no mercado de eventos traduzidos em uma celebração cuidadosamente planejada, que une estrutura sofisticada, gastronomia impecável e um atendimento próximo em cada etapa da jornada.</p>
    </div>
  </section>

  
  <section data-dc-tpl="62" class="r-sec" style="background: #ffffff; padding: 104px 60px;">
    <div data-dc-tpl="63" data-reveal="" style="max-width: 820px; margin: 0px auto 60px; text-align: center; opacity: 1; transform: none; transition: opacity 0.8s, transform 0.8s;">
      <span data-dc-tpl="64" style="font-size: 10px; letter-spacing: 5px; text-transform: uppercase; color: #A27D28; margin-bottom: 20px; display: block; font-weight: 600;">Diferenciais</span>
      <h2 data-dc-tpl="65" style="font-family: Georgia, serif; font-size: clamp(28px, 2.8vw, 44px); font-weight: 400; color: #2f1d13; line-height: 1.2; letter-spacing: -0.2px;">Por que os noivos<br /><span data-dc-tpl="66" style="font-weight: 500; color: #A27D28;">escolhem o Krispy?</span></h2>
    </div>
    <div data-dc-tpl="67" class="r-grid3" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; max-width: 1100px; margin: 0px auto;">
      <div data-dc-tpl="68" data-reveal="" class="scp3" style="background: #ffffff; border: 1px solid rgba(162, 125, 40, 0.2); overflow: hidden; transition: opacity 0.8s, transform 0.8s; opacity: 1; transform: none;">
        <div style="aspect-ratio: 4 / 3; overflow: hidden;">
          <img src="https://media.dmove.com.br/clients/krispy/photos/WhatsApp_Image_2026-05-31_at_12.01.50_PM_(2).webp" alt="Tudo em um só lugar — Krispy Buffet" loading="lazy" style="width: 100%; height: 100%; object-fit: cover; display: block;" />
        </div>
        <div data-dc-tpl="70" style="padding: 34px 30px 38px;">
          <h3 data-dc-tpl="71" style="font-family: Georgia, serif; font-size: 24px; font-weight: 500; color: #2f1d13; margin-bottom: 12px; line-height: 1.25;">Tudo em um só lugar</h3>
          <p data-dc-tpl="72" style="font-size: 14px; line-height: 1.75; color: rgba(47, 29, 19, 0.7); font-weight: 300;">Espaço e buffet integrados para simplificar a organização do casamento.</p>
        </div>
      </div>
      <div data-dc-tpl="73" data-reveal="" class="scp3" style="background: #ffffff; border: 1px solid rgba(162, 125, 40, 0.2); overflow: hidden; transition: opacity 0.8s, transform 0.8s; opacity: 1; transform: none;">
        <div style="aspect-ratio: 4 / 3; overflow: hidden;">
          <img src="https://media.dmove.com.br/clients/krispy/photos/nosso-buffet_img7129.webp" alt="Gastronomia própria — Krispy Buffet" loading="lazy" style="width: 100%; height: 100%; object-fit: cover; display: block;" />
        </div>
        <div data-dc-tpl="75" style="padding: 34px 30px 38px;">
          <h3 data-dc-tpl="76" style="font-family: Georgia, serif; font-size: 24px; font-weight: 500; color: #2f1d13; margin-bottom: 12px; line-height: 1.25;">Gastronomia própria</h3>
          <p data-dc-tpl="77" style="font-size: 14px; line-height: 1.75; color: rgba(47, 29, 19, 0.7); font-weight: 300;">Menus modernos, saborosos e preparados por uma equipe experiente.</p>
        </div>
      </div>
      <div data-dc-tpl="78" data-reveal="" class="scp3" style="background: #ffffff; border: 1px solid rgba(162, 125, 40, 0.2); overflow: hidden; transition: opacity 0.8s, transform 0.8s; opacity: 1; transform: none;">
        <div style="aspect-ratio: 4 / 3; overflow: hidden;">
          <img src="https://media.dmove.com.br/clients/krispy/photos/15-anos-bella_img9224.webp" alt="Excelente custo-benefício — Krispy Buffet" loading="lazy" style="width: 100%; height: 100%; object-fit: cover; display: block;" />
        </div>
        <div data-dc-tpl="80" style="padding: 34px 30px 38px;">
          <h3 data-dc-tpl="81" style="font-family: Georgia, serif; font-size: 24px; font-weight: 500; color: #2f1d13; margin-bottom: 12px; line-height: 1.25;">Excelente custo-benefício</h3>
          <p data-dc-tpl="82" style="font-size: 14px; line-height: 1.75; color: rgba(47, 29, 19, 0.7); font-weight: 300;">A sofisticação que você procura com investimento inteligente.</p>
        </div>
      </div>
    </div>
  </section>

  
  <section data-dc-tpl="83" class="r-sec" style="background: #2f1d13; padding: 108px 60px;">
    <div data-dc-tpl="84" data-reveal="" style="max-width: 760px; margin: 0px auto 56px; text-align: center; opacity: 1; transform: none; transition: opacity 0.8s, transform 0.8s;">
      <span data-dc-tpl="85" style="font-size: 10px; letter-spacing: 5px; text-transform: uppercase; color: #A27D28; margin-bottom: 20px; display: block; font-weight: 600;">Experiência Krispy</span>
      <h2 data-dc-tpl="86" style="font-family: Georgia, serif; font-size: clamp(28px, 2.8vw, 44px); font-weight: 400; color: #f6f2ec; line-height: 1.2; margin-bottom: 26px; letter-spacing: -0.2px;">Você vive esse dia tão esperado.<br /><span data-dc-tpl="87" style="font-weight: 500; color: #A27D28;">Nós cuidamos do restante.</span></h2>
      <p data-dc-tpl="88" style="font-size: 16px; line-height: 1.9; color: rgba(255, 255, 255, 0.6); font-weight: 300;">Por trás de cada detalhe existe uma equipe preparada para transformar sonhos em realidade, com leveza, organização e cuidado, para que a única coisa que importe seja celebrar ao lado de quem vocês mais amam.</p>
    </div>
    <div data-dc-tpl="89" class="r-grid3" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 3px; max-width: 1100px; margin: 0px auto 48px;">
      <div style="aspect-ratio: 3 / 4; overflow: hidden;">
        <img src="https://media.dmove.com.br/clients/krispy/photos/nossa-estrutura_tc4tpf7zzzfv6bozkwmhoxxtyw6xwio0f9mwc8-ai30plaintext638207976441560946.webp" alt="Estrutura Krispy Buffet" loading="lazy" style="width: 100%; height: 100%; object-fit: cover; display: block;" />
      </div>
      <div style="aspect-ratio: 3 / 4; overflow: hidden;">
        <img src="https://media.dmove.com.br/clients/krispy/photos/nossa-estrutura_8929408427048584630768673765234606761050112n.webp" alt="Estrutura Krispy Buffet" loading="lazy" style="width: 100%; height: 100%; object-fit: cover; display: block;" />
      </div>
      <div style="aspect-ratio: 3 / 4; overflow: hidden;">
        <img src="https://media.dmove.com.br/clients/krispy/photos/WhatsApp_Image_2026-05-05_at_14.15.03_(3).webp" alt="Experiência Krispy Buffet" loading="lazy" style="width: 100%; height: 100%; object-fit: cover; display: block;" />
      </div>
    </div>
  </section>

  
  <section data-dc-tpl="95" id="estrutura" class="r-sec" style="background: #ffffff; padding: 104px 60px; scroll-margin-top: 80px;">
    <div data-dc-tpl="96" data-reveal="" style="max-width: 840px; margin: 0px auto 60px; text-align: center; opacity: 1; transform: none; transition: opacity 0.8s, transform 0.8s;">
      <span data-dc-tpl="97" style="font-size: 10px; letter-spacing: 5px; text-transform: uppercase; color: #A27D28; margin-bottom: 20px; display: block; font-weight: 600;">Estrutura</span>
      <h2 data-dc-tpl="98" style="font-family: Georgia, serif; font-size: clamp(28px, 2.8vw, 44px); font-weight: 400; color: #2f1d13; line-height: 1.2; margin-bottom: 24px; letter-spacing: -0.2px;">Uma estrutura completa para receber<br /><span data-dc-tpl="99" style="font-weight: 500; color: #A27D28;">quem faz parte da sua história</span></h2>
      <p data-dc-tpl="100" style="font-size: 16px; line-height: 1.85; color: rgba(47, 29, 19, 0.7); font-weight: 300; max-width: 600px; margin: 0px auto;">Nosso espaço foi pensado para oferecer conforto, praticidade e sofisticação em todos os momentos da celebração.</p>
    </div>
    <div data-dc-tpl="101" class="r-grid4" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 2px; max-width: 1140px; margin: 0px auto;">
      
        <div data-dc-tpl="103" data-reveal="" class="scp5" style="background: #ffffff; border: 1px solid rgba(162, 125, 40, 0.18); padding: 42px 30px; text-align: center; transition: opacity 0.8s, transform 0.8s; opacity: 1; transform: none;">
          <div data-dc-tpl="104" style="width: 56px; height: 56px; border: 1px solid rgba(162, 125, 40, 0.4); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0px auto 22px;"><svg viewBox="0 0 24 24" fill="none" stroke="#A27D28" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="width: 24px; height: 24px;"><rect x="3" y="4" width="18" height="14" rx="1"></rect><path d="M3 18h18M8 21h8"></path></svg></div>
          <span data-dc-tpl="105" style="font-size: 13px; font-weight: 500; color: #2f1d13; letter-spacing: 0.3px; line-height: 1.5; display: block;"><span class="sc-interp">Salão interno moderno<br />e climatizado</span></span>
        </div>
      
        <div data-dc-tpl="103" data-reveal="" class="scp5" style="background: #ffffff; border: 1px solid rgba(162, 125, 40, 0.18); padding: 42px 30px; text-align: center; transition: opacity 0.8s, transform 0.8s; opacity: 1; transform: none;">
          <div data-dc-tpl="104" style="width: 56px; height: 56px; border: 1px solid rgba(162, 125, 40, 0.4); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0px auto 22px;"><svg viewBox="0 0 24 24" fill="none" stroke="#A27D28" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="width: 24px; height: 24px;"><path d="M12 2l2.4 5.5L20 8l-4 4 1 6-5-3-5 3 1-6-4-4 5.6-.5z"></path></svg></div>
          <span data-dc-tpl="105" style="font-size: 13px; font-weight: 500; color: #2f1d13; letter-spacing: 0.3px; line-height: 1.5; display: block;"><span class="sc-interp">Ambiente sofisticado<br />e versátil</span></span>
        </div>
      
